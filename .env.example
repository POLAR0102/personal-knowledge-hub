# Docker Compose ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

APP_NAME=Personal Knowledge Hub API
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local Embedding works without an API key. The model is cached persistently.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
AI_API_KEY=
AI_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

CHROMA_COLLECTION_NAME=document_chunks
SEMANTIC_SEARCH_TOP_K=4
KNOWLEDGE_BASE_REINDEX_LIMIT=50

# DeepSeek Chat configuration. Keep the real key only in .env.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=800
RAG_MAX_CONTEXT_CHARS=12000

MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
