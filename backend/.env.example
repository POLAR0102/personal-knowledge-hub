APP_NAME=Personal Knowledge Hub API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./personal_knowledge_hub.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Local Embedding is used for indexing and does not require an API key.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_CACHE_DIR=./model_cache

# These two values are only needed when EMBEDDING_PROVIDER=openai-compatible.
AI_API_KEY=
AI_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=document_chunks
SEMANTIC_SEARCH_TOP_K=4
KNOWLEDGE_BASE_REINDEX_LIMIT=50

# DeepSeek Chat is used only for RAG answer generation. Keep the real key in .env.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=800
RAG_MAX_CONTEXT_CHARS=12000

# Console logging is always enabled. Uncomment LOG_FILE for rotating file logs.
LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
